# El puerto que escucha el servicio. Sin él, pagos escucha en el 8083 de Plaza.
PORT=8083

# Orígenes permitidos, separados por coma. Una lista vacía no permite ninguno:
# un contenedor que nadie configuró falla cerrado. A pagos solo lo llama el BFF.
CORS_ALLOWED_ORIGINS=

# El ambiente donde corre: development, qa o production. La imagen trae
# `production`, el más restrictivo: sin él no se publica la documentación.
NODE_ENV=development

# Las credenciales de la base salen de Vault (ADR-049). El secreto
# plaza/payments/db trae DB_URL, DB_USERNAME y DB_PASSWORD. Los valores son los
# del compose de nova-plaza-01-shared-platform, solo para esta máquina.
NOVA_SECRETS_IMPORT=vault:plaza/payments/db
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=plaza-local-root

# El monto más alto que se autoriza; uno mayor es un 422 PAYMENT_DECLINED.
PAYMENTS_MAX_AMOUNT=1000
